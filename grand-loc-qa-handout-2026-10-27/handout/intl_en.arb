  "schTutorialPrincipalName": "Principal",
  "schTutorialToGame": "Let's play!",
  "schTutorialPickSideTitle": "Choose your side!",
  "schTutorialPickSideSubtitle": "You won't be able to switch teams after making your choice",
  "schTutorialRecommended": "Recommended",
  "schTutorialSelected": "Selected",
