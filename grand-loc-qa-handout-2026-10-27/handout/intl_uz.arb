  "schTutorialToGame": "O‘yinga!",
  "schTutorialPickSideTitle": "Qaysi tomonda ekaningni tanla!",
  "schTutorialPickSideSubtitle": "Tomonni tanlaganingizdan so‘ng jamoani almashtirib bo‘lmaydi",
  "schTutorialRecommended": "Tavsiya etiladi",
